# Postgres em produção; SQLite no dev local (nenhuma outra diferença de config).
# Railway expõe a URL do Postgres como DATABASE_URL automaticamente no serviço.
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Gere com: python scripts/generate_encryption_key.py
CREDENTIALS_ENCRYPTION_KEY=change-me-generate-with-fernet
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
