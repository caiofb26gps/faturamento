DATABASE_URL=sqlite:///./dev.db
# Preenchidos = a app usa Turso em vez de DATABASE_URL. Deixe em branco no dev
# local em Windows: o dialeto sqlalchemy-libsql não instala aqui (compila Rust).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Mesmas credenciais do Turso, lidas só pelos scripts scripts/_criar_*_turso.py
# (falam via HTTP, funcionam no Windows). Úteis pra fazer bootstrap do banco de
# produção a partir da máquina local.
TURSO_BOOTSTRAP_URL=
TURSO_BOOTSTRAP_TOKEN=
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CREDENTIALS_ENCRYPTION_KEY=change-me-generate-with-fernet
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
